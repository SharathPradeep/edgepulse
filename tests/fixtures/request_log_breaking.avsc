{
  "type": "record",
  "name": "RequestLog",
  "namespace": "com.edgepulse.gateway",
  "doc": "Deliberately BREAKING version of request_log, used to prove the compatibility gate. Never register it. tls_version is required with no default, so a v2 reader cannot read events written with v1.",
  "fields": [
    {"name": "event_id", "type": "string"},
    {"name": "event_type", "type": "string"},
    {"name": "device_id", "type": "string"},
    {"name": "tenant_id", "type": "string"},
    {"name": "product_version", "type": "string"},
    {"name": "event_ts", "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "schema_version", "type": "int"},
    {"name": "method", "type": "string"},
    {"name": "path", "type": "string"},
    {"name": "status_code", "type": "int"},
    {"name": "latency_ms", "type": "double"},
    {"name": "bytes_out", "type": "long"},
    {"name": "client_ip", "type": "string"},
    {"name": "client_region", "type": "string"},
    {"name": "headers", "type": {"type": "map", "values": "string"}},
    {"name": "tls_version", "type": "string"}
  ]
}
