{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "S3Bucket",
            "Effect": "Allow",
            "Action": [
                "s3:ListBucket",
                "s3:GetBucketLocation"
            ],
            "Resource": "arn:aws:s3:::edgepulse-lake-sharath-0001"
        },
        {
            "Sid": "S3Objects",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:DeleteObject",
                "s3:AbortMultipartUpload"
            ],
            "Resource": "arn:aws:s3:::edgepulse-lake-sharath-0001/*"
        },
        {
            "Sid": "GlueCatalog",
            "Effect": "Allow",
            "Action": [
                "glue:*Database*",
                "glue:*Table*",
                "glue:*Partition*"
            ],
            "Resource": [
                "arn:aws:glue:eu-north-1:ACCOUNT_ID:catalog",
                "arn:aws:glue:eu-north-1:ACCOUNT_ID:database/ep_*",
                "arn:aws:glue:eu-north-1:ACCOUNT_ID:database/default",
                "arn:aws:glue:eu-north-1:ACCOUNT_ID:table/ep_*/*"
            ]
        },
        {
            "Sid": "AthenaWorkgroup",
            "Effect": "Allow",
            "Action": [
                "athena:StartQueryExecution",
                "athena:GetQueryExecution",
                "athena:GetQueryResults",
                "athena:StopQueryExecution",
                "athena:GetWorkGroup",
                "athena:ListQueryExecutions",
                "athena:BatchGetQueryExecution"
            ],
            "Resource": "arn:aws:athena:eu-north-1:ACCOUNT_ID:workgroup/edgepulse"
        },
        {
            "Sid": "AthenaCatalog",
            "Effect": "Allow",
            "Action": [
                "athena:GetDataCatalog",
                "athena:ListDatabases",
                "athena:GetDatabase",
                "athena:ListTableMetadata",
                "athena:GetTableMetadata"
            ],
            "Resource": "arn:aws:athena:eu-north-1:ACCOUNT_ID:datacatalog/AwsDataCatalog"
        },
        {
            "Sid": "AthenaList",
            "Effect": "Allow",
            "Action": [
                "athena:ListWorkGroups",
                "athena:ListDataCatalogs",
                "lakeformation:GetDataAccess"
            ],
            "Resource": "*"
        }
    ]
}